{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kairos0922/evaluation-dataset-builder/blob/main/docs/quality-assessment-v0.0.2/schemas/ida-report.schema.json",
  "title": "Independent Dataset Assessment Report",
  "type": "object",
  "required": [
    "schema_version",
    "assessment_id",
    "assessment_type",
    "created_at",
    "dataset",
    "evaluation_purpose",
    "assessor",
    "overall_status",
    "gate_results",
    "metric_results",
    "evidence_sufficiency",
    "composite",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "0.0.2" },
    "assessment_id": { "type": "string", "minLength": 1 },
    "assessment_type": { "const": "independent_dataset_assessment" },
    "created_at": { "type": "string", "format": "date-time" },
    "dataset": {
      "type": "object",
      "required": ["dataset_id", "version", "sha256", "case_count"],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "case_count": { "type": "integer", "minimum": 0 },
        "manifest_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "evaluation_purpose": { "enum": ["capability", "regression", "both"] },
    "assessor": {
      "type": "object",
      "required": ["name", "version", "independence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "independence": { "enum": ["independent", "same_author", "mixed", "unknown"] },
        "review_protocol_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "overall_status": { "enum": ["PASS", "FAIL", "PARTIAL", "NOT_ASSESSED"] },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate_id", "status", "severity", "rationale", "evidence_refs"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "MEASURED", "UNKNOWN", "NOT_RUN", "NOT_ASSESSED", "NOT_APPLICABLE"] },
          "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
          "rationale": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "metric_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id", "status", "value", "unit", "evidence_refs", "limitations"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "MEASURED", "UNKNOWN", "NOT_RUN", "NOT_ASSESSED", "NOT_APPLICABLE", "NOT_VALIDATED"] },
          "value": { "type": ["number", "string", "object", "null"] },
          "unit": { "type": ["string", "null"] },
          "numerator": { "type": ["number", "integer", "null"] },
          "denominator": { "type": ["number", "integer", "null"] },
          "interval": {
            "type": ["object", "null"],
            "required": ["lower", "upper", "level", "method"],
            "properties": {
              "lower": { "type": "number" },
              "upper": { "type": "number" },
              "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
              "method": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidence_sufficiency": {
      "type": "object",
      "required": ["status", "rationale", "missing_evidence"],
      "properties": {
        "status": { "enum": ["sufficient_for_scope", "partial", "insufficient", "not_assessed"] },
        "rationale": { "type": "string" },
        "missing_evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "composite": {
      "type": "object",
      "required": ["status", "value", "model_id", "scope", "validation_report_ref", "limitations"],
      "properties": {
        "status": { "enum": ["NOT_COMPUTED", "NOT_VALIDATED", "PARTIALLY_VALIDATED", "VALIDATED_FOR_SCOPE", "REJECTED"] },
        "value": { "type": ["number", "null"] },
        "model_id": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "validation_report_ref": { "type": ["string", "null"] },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "VALIDATED_FOR_SCOPE" } }, "required": ["status"] },
          "then": {
            "properties": {
              "value": { "type": "number" },
              "model_id": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "validation_report_ref": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["NOT_COMPUTED", "NOT_VALIDATED", "REJECTED"] } }, "required": ["status"] },
          "then": { "properties": { "value": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "description", "evidence_refs", "affected_case_ids"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
          "description": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "affected_case_ids": { "type": "array", "items": { "type": "string" } },
          "recommendation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "not_assessed": { "type": "array", "items": { "type": "string" } },
    "not_applicable": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}