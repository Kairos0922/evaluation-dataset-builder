{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kairos0922/evaluation-dataset-builder/blob/main/docs/quality-assessment-v0.0.2/schemas/round4-oracle-record.schema.json",
  "title": "Round 4 Independent Oracle Record",
  "description": "One independently adjudicated Oracle record for a frozen Round 4 case. Application behavior and Skill behavior are separate outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "dataset_id",
    "dataset_version",
    "dataset_sha256",
    "case_id",
    "case_sha256",
    "oracle_plan_sha256",
    "blind_execution",
    "sources",
    "environment",
    "run",
    "observations",
    "action_budget",
    "application_outcome",
    "skill_outcome",
    "adjudication",
    "record_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^OR-R4-[A-Za-z0-9_-]+$"
    },
    "dataset_id": {
      "const": "wb-core"
    },
    "dataset_version": {
      "const": "1.0.0"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "case_id": {
      "type": "string",
      "enum": [
        "WB-01",
        "WB-03",
        "WB-04",
        "WB-05",
        "WB-06",
        "WB-07",
        "WB-08",
        "WB-09",
        "WB-11",
        "WB-13",
        "WB-14",
        "WB-15"
      ]
    },
    "case_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oracle_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blind_execution": {
      "type": "boolean",
      "const": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "sha256",
          "authority_role",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "authority_role": {
            "type": "string",
            "enum": [
              "normative_rule",
              "task_context",
              "runtime_contract",
              "fixture_identity"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_image",
        "python_version",
        "playwright_version",
        "chromium_version",
        "fixture_sha256"
      ],
      "properties": {
        "runner_image": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "playwright_version": {
          "type": "string",
          "minLength": 1
        },
        "chromium_version": {
          "type": "string",
          "minLength": 1
        },
        "fixture_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "server_py",
            "app_js",
            "index_html"
          ],
          "properties": {
            "server_py": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "app_js": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "index_html": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "execution_status",
        "attempt_count",
        "reset_verified"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "completed",
            "stopped",
            "unknown"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "const": 1
        },
        "reset_verified": {
          "type": "boolean"
        },
        "initial_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "final_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "assertion_id",
          "normative_ref",
          "method",
          "expected_summary",
          "observed_summary",
          "outcome",
          "evidence_refs"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "normative_ref": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "enum": [
              "api_state",
              "dom",
              "accessibility_snapshot",
              "playwright_trace",
              "browser_event_log",
              "server_audit",
              "human_blind_review",
              "runner_contract"
            ]
          },
          "expected_summary": {
            "type": "string",
            "minLength": 1
          },
          "observed_summary": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "action_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_script_runs",
        "observed_script_runs",
        "max_write_actions",
        "observed_write_actions",
        "budget_exceeded"
      ],
      "properties": {
        "max_script_runs": {
          "type": "integer",
          "const": 1
        },
        "observed_script_runs": {
          "type": "integer",
          "minimum": 0
        },
        "max_write_actions": {
          "type": "integer",
          "minimum": 0
        },
        "observed_write_actions": {
          "type": "integer",
          "minimum": 0
        },
        "budget_exceeded": {
          "type": "boolean"
        }
      }
    },
    "application_outcome": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "skill_outcome": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_ids",
        "independent_decisions",
        "consensus_status"
      ],
      "properties": {
        "reviewer_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^R-[A-Za-z0-9_-]+$"
          }
        },
        "independent_decisions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer_id",
              "application_outcome",
              "skill_outcome",
              "rationale",
              "evidence_refs"
            ],
            "properties": {
              "reviewer_id": {
                "type": "string",
                "pattern": "^R-[A-Za-z0-9_-]+$"
              },
              "application_outcome": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "skill_outcome": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 10
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "consensus_status": {
          "type": "string",
          "enum": [
            "pending",
            "agreed",
            "adjudicated",
            "needs_more_evidence"
          ]
        },
        "final_application_outcome": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "final_skill_outcome": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "adjudication_note": {
          "type": "string"
        }
      }
    },
    "record_status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_for_review",
        "accepted",
        "needs_more_evidence",
        "rejected"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "case_id": {
            "const": "WB-15"
          }
        },
        "required": [
          "case_id"
        ]
      },
      "then": {
        "properties": {
          "application_outcome": {
            "const": "UNKNOWN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_budget": {
            "properties": {
              "budget_exceeded": {
                "const": true
              }
            },
            "required": [
              "budget_exceeded"
            ]
          },
          "run": {
            "properties": {
              "execution_status": {
                "const": "completed"
              }
            },
            "required": [
              "execution_status"
            ]
          }
        },
        "required": [
          "action_budget",
          "run"
        ]
      },
      "then": {
        "properties": {
          "skill_outcome": {
            "const": "FAIL"
          }
        }
      }
    }
  ]
}
