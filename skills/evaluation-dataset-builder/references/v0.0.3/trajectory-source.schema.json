{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluation-dataset-builder.local/schemas/v0.0.3/trajectory-source.schema.json",
  "title": "Trajectory Source Record",
  "description": "Provenance and authorization metadata for a user-provided or explicitly authorized Agent trace. Does not store raw trace content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_kind",
    "authorization",
    "redaction_status",
    "artifact",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.0.3"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_kind": {
      "enum": [
        "agent_session_export",
        "runner_trace",
        "tool_event_log",
        "user_curated_excerpt",
        "synthetic_fixture"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "explicit_user_authorized",
            "user_provided",
            "synthetic_only",
            "not_authorized",
            "unknown"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "authorized_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "redaction_status": {
      "enum": [
        "redacted_and_reviewed",
        "no_sensitive_content_attested",
        "pending_review",
        "not_redacted",
        "unknown"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "byte_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "agent_revision": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "harness_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "environment_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  }
}
