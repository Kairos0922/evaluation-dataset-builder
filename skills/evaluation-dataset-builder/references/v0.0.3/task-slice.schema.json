{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluation-dataset-builder.local/schemas/v0.0.3/task-slice.schema.json",
  "title": "Evaluation Task Slice",
  "description": "A bounded, independently executable task reconstructed from a source trace, with explicit context closure and evaluation contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice_id",
    "candidate_id",
    "qualification_id",
    "source_id",
    "trace_boundary",
    "initial_context",
    "task",
    "evaluation_contract",
    "leakage_review",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.0.3"
    },
    "slice_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "qualification_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trace_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_event_ref",
        "end_event_ref",
        "boundary_rationale"
      ],
      "properties": {
        "start_event_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "end_event_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "boundary_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "initial_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_refs",
        "closure_review",
        "omitted_context_rationale"
      ],
      "properties": {
        "context_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "closure_review": {
          "enum": [
            "complete",
            "incomplete",
            "uncertain"
          ]
        },
        "omitted_context_rationale": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction",
        "inputs",
        "deliverables",
        "constraints"
      ],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "prohibited_side_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "capability_hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "evaluation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grading_mode"
      ],
      "properties": {
        "criteria_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "acceptable_variants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "unknown_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "grading_mode": {
          "enum": [
            "deterministic",
            "rubric",
            "hybrid",
            "human_review",
            "not_yet_defined"
          ]
        }
      }
    },
    "leakage_review": {
      "enum": [
        "passed",
        "failed",
        "pending",
        "unknown"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready_for_reconstruction",
        "rejected",
        "unknown"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3000
    }
  }
}
