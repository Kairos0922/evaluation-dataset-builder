{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "评测数据集用例",
  "type": "object",
  "required": [
    "case_id",
    "dataset_id",
    "title",
    "evaluation_target",
    "objective",
    "user_input",
    "expected_behavior",
    "grading",
    "source_refs",
    "quality_status",
    "scenario_bucket",
    "case_origin",
    "coverage_tags"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "description": "用例的稳定且唯一标识。更新数据集时不得因内容修订而随意更改。"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "description": "所属数据集的稳定标识。"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "用例标题，应简洁描述被测场景。"
    },
    "evaluation_target": {
      "type": "string",
      "minLength": 1,
      "description": "被评测的系统、Agent、Skill、API、工作流或具体能力。"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "本用例需要验证的具体行为或能力，应可观察、可判定。"
    },
    "capability_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "本用例覆盖的能力标识列表。"
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "业务场景的稳定标识；没有可复用场景标识时可以为空。"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "not_applicable"
      ],
      "description": "风险等级。枚举值是机器标识，保持原样。"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_type",
          "title"
        ],
        "properties": {
          "source_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "来源的稳定标识。"
          },
          "source_type": {
            "enum": [
              "authoritative_policy",
              "system_documentation",
              "confirmed_expert_process",
              "verified_historical_eval",
              "incident_ticket",
              "user_feedback",
              "trace_log",
              "derived_scenario",
              "synthetic_scenario",
              "inference_assumption"
            ],
            "description": "来源类别。枚举值是机器标识，保持原样。"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "来源标题或名称。"
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "来源版本；未提供时填写 null。"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "来源生效日期；未提供时填写 null。"
          },
          "authority": {
            "type": "string",
            "description": "来源责任方及其适用权限范围。"
          },
          "locator": {
            "type": "string",
            "description": "可定位到具体内容的位置，例如章节、条款、URL 或文件页码。",
            "minLength": 1
          },
          "quoted_evidence": {
            "type": "string",
            "description": "支撑本项结论的原文证据；不得编造或改写成伪引文。"
          }
        },
        "additionalProperties": true
      },
      "description": "支撑用例和预期行为的来源记录。不得填写虚构来源。"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "执行用例前必须成立的状态、权限和环境条件。"
    },
    "user_input": {
      "type": [
        "string",
        "object",
        "array"
      ],
      "description": "提供给被测对象的输入内容。"
    },
    "expected_behavior": {
      "type": [
        "string",
        "array",
        "object"
      ],
      "description": "被测对象应表现出的明确、可观察行为。"
    },
    "forbidden_behavior": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "被测对象不得出现的行为。"
    },
    "reference_outcome": {
      "type": [
        "object",
        "array",
        "string",
        "null"
      ],
      "description": "有可信依据时填写的参考结果；依据不足时不得编造。"
    },
    "grading": {
      "type": "object",
      "required": [
        "method",
        "criteria",
        "pass_conditions",
        "fail_conditions",
        "evidence_required"
      ],
      "properties": {
        "method": {
          "enum": [
            "rule_based",
            "reference_match",
            "rubric_based",
            "state_check",
            "trace_check",
            "hybrid",
            "human_review"
          ],
          "description": "评分方法。枚举值是机器标识，保持原样。"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "criterion_id",
              "description",
              "pass_condition",
              "fail_condition",
              "evidence_required"
            ],
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1,
                "description": "评分项稳定标识。"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "本评分项判定的具体要求。"
              },
              "pass_condition": {
                "type": "string",
                "minLength": 1,
                "description": "本项通过的可观察条件。"
              },
              "fail_condition": {
                "type": "string",
                "minLength": 1,
                "description": "本项失败的可观察条件。"
              },
              "evidence_required": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "本项判定所需证据。"
              }
            },
            "additionalProperties": true
          },
          "description": "至少包含一项可独立判定的评分标准。"
        },
        "pass_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "判为通过必须满足的条件。",
          "minItems": 1
        },
        "fail_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "判为失败的条件。",
          "minItems": 1
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "作出判定前必须取得的证据。",
          "minItems": 1
        },
        "acceptable_variants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "允许的等价表达或结果变体。"
        },
        "partial_credit_policy": {
          "type": "string",
          "description": "允许部分得分时的规则；不允许时明确说明。"
        },
        "uncertainty_policy": {
          "type": "string",
          "description": "证据缺失、歧义或无法核验时的处理规则。"
        },
        "reference_authority": {
          "type": "string",
          "description": "参考依据的来源和权威性。"
        },
        "calibration_cases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "用于校准评分器的用例 ID。"
        }
      },
      "additionalProperties": true,
      "description": "评分器的判定方法、标准、证据和校准要求。"
    },
    "execution_requirements": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "DESIGN_ONLY",
            "READY_TO_RUN",
            "EXECUTION_VERIFIED",
            "NOT_RUN"
          ],
          "description": "执行状态。枚举值是机器标识，保持原样。"
        },
        "initial_state": {
          "type": [
            "object",
            "array",
            "string"
          ],
          "description": "执行前必须存在的初始状态。"
        },
        "required_permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "执行所需身份和权限。",
          "minItems": 1
        },
        "environment": {
          "type": "object",
          "description": "执行环境及隔离要求。",
          "minProperties": 1
        },
        "test_data": {
          "type": "array",
          "items": {},
          "description": "测试数据和外部依赖。"
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "本用例允许执行的操作。",
          "minItems": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "按顺序执行的具体步骤。",
          "minItems": 1
        },
        "expected_end_state": {
          "type": [
            "object",
            "array",
            "string"
          ],
          "description": "执行后必须达到的状态。"
        },
        "observable_assertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "用于验证结果的可观察断言。",
          "minItems": 1
        },
        "forbidden_side_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "不得产生的副作用。",
          "minItems": 1
        },
        "reset_plan": {
          "type": "string",
          "description": "测试结束后的状态重置或回滚步骤。",
          "minLength": 1
        },
        "cleanup_plan": {
          "type": "string",
          "description": "正常结束时必须完成的清理步骤。",
          "minLength": 1
        },
        "failure_cleanup": {
          "type": "string",
          "description": "执行失败时必须执行的清理步骤。",
          "minLength": 1
        },
        "cost_and_rate_limits": {
          "type": "object",
          "description": "本用例适用的成本、频率和资源限制。"
        },
        "execution_evidence": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "description": "真实执行记录的标识。",
              "minLength": 1
            },
            "executed_at": {
              "type": "string",
              "format": "date-time"
            },
            "candidate_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "artifact_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "state_before": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "执行前的状态快照。"
            },
            "state_after": {
              "type": [
                "object",
                "array",
                "string"
              ],
              "description": "执行后的状态快照。"
            }
          },
          "additionalProperties": true,
          "description": "实际执行后形成的证据；未执行时不得填写虚构内容。",
          "required": [
            "run_id",
            "executed_at",
            "candidate_sha",
            "artifact_refs"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "READY_TO_RUN",
                  "EXECUTION_VERIFIED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "status",
              "initial_state",
              "required_permissions",
              "environment",
              "test_data",
              "allowed_actions",
              "steps",
              "expected_end_state",
              "observable_assertions",
              "forbidden_side_effects",
              "reset_plan",
              "cleanup_plan",
              "failure_cleanup"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "EXECUTION_VERIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "status",
              "initial_state",
              "required_permissions",
              "environment",
              "test_data",
              "allowed_actions",
              "steps",
              "expected_end_state",
              "observable_assertions",
              "forbidden_side_effects",
              "reset_plan",
              "cleanup_plan",
              "failure_cleanup",
              "execution_evidence"
            ]
          }
        }
      ],
      "additionalProperties": true,
      "description": "执行环境、权限、步骤、终态、断言和清理要求。"
    },
    "quality_status": {
      "enum": [
        "candidate",
        "validated",
        "approved",
        "needs_info",
        "rejected"
      ],
      "description": "用例质量状态。枚举值是机器标识，保持原样。"
    },
    "quality_review": {
      "type": "object",
      "required": [
        "review_id",
        "reviewer",
        "reviewed_at",
        "decision",
        "evidence_refs"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1,
          "description": "正式批准记录引用；approved 状态必填。"
        }
      },
      "additionalProperties": true,
      "description": "独立质量审查记录。validated/approved 状态必须提供；approved 还必须具有审批引用。"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "尚未确认的推断或假设。必须明确标记，不得作为事实。"
    },
    "version": {
      "type": "string",
      "description": "用例或所属数据集的版本标识。"
    },
    "business_rule_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "关联的稳定业务规则标识。"
    },
    "workflow_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "关联的流程、流程节点或状态转换标识。"
    },
    "scenario_bucket": {
      "type": "array",
      "items": {
        "enum": [
          "normal",
          "boundary",
          "business_rule",
          "permission_security",
          "state_anomaly",
          "error_recovery",
          "multi_turn",
          "tool_interaction",
          "negative",
          "adversarial",
          "data_quality",
          "integration",
          "other"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "用于覆盖检查的场景桶列表；一条用例可以关联多个适用场景桶。"
    },
    "case_origin": {
      "enum": [
        "business_document",
        "historical_defect",
        "user_feedback",
        "execution_trace",
        "synthetic_gap_fill",
        "template_derived",
        "mixed",
        "unknown"
      ],
      "description": "用例来源类型。合成补缺用例不得冒充真实业务案例。"
    },
    "coverage_tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "value",
          "coverage_item_id"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "coverage_item_id": {
            "type": "string",
            "minLength": 1,
            "description": "覆盖全集中对应覆盖项的稳定标识。"
          }
        },
        "additionalProperties": true
      },
      "description": "至少关联一个明确的覆盖项；用于覆盖矩阵与缺口追溯。",
      "minItems": 1
    },
    "observable_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertion_id",
          "observation",
          "pass_condition"
        ],
        "properties": {
          "assertion_id": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "pass_condition": {
            "type": "string"
          },
          "fail_condition": {
            "type": "string"
          },
          "evidence_source": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": true
      },
      "description": "与评分器关联的外部可观察断言。"
    },
    "trace_expectations": {
      "type": "object",
      "properties": {
        "required_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameter_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_steps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "required_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "description": "Agent/Skill/工具流程的轨迹约束；不适用时省略。"
    },
    "change_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change_id",
          "relation"
        ],
        "properties": {
          "change_id": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "affected_by",
              "validates",
              "supersedes",
              "derived_from"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "description": "关联变更记录，支持影响分析和局部修复。"
    },
    "information_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "description",
          "affected_claims",
          "required_evidence",
          "responsible_role",
          "status"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "affected_claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "responsible_role": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "RESOLVED"
            ]
          }
        },
        "additionalProperties": true
      },
      "description": "记录缺失或待裁决信息；不能以空来源或虚构来源替代。"
    }
  },
  "additionalProperties": true,
  "$comment": "字段名、枚举值和机器标识保持原样；字段含义及填写要求使用中文说明。自然语言字段默认使用简体中文。",
  "allOf": [
    {
      "if": {
        "properties": {
          "case_origin": {
            "enum": [
              "business_document",
              "historical_defect",
              "user_feedback",
              "execution_trace",
              "mixed",
              "template_derived"
            ]
          }
        },
        "required": [
          "case_origin"
        ]
      },
      "then": {
        "properties": {
          "source_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_origin": {
            "const": "synthetic_gap_fill"
          }
        },
        "required": [
          "case_origin"
        ]
      },
      "then": {
        "required": [
          "assumptions"
        ],
        "properties": {
          "assumptions": {
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_refs": {
            "minItems": 1,
            "contains": {
