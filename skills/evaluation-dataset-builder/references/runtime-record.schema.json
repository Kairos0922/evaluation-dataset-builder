{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kairos0922/evaluation-dataset-builder/blob/main/skills/evaluation-dataset-builder/references/runtime-record.schema.json",
  "title": "Agent / Skill Runtime Evaluation Record",
  "type": "object",
  "required": [
    "record_version",
    "run_id",
    "dataset_id",
    "dataset_sha256",
    "case_id",
    "configuration_id",
    "target_revision",
    "target_type",
    "model",
    "harness",
    "environment",
    "tool_versions",
    "status",
    "started_at",
    "trace_ref",
    "outcomes",
    "fault",
    "cost"
  ],
  "properties": {
    "record_version": { "const": "0.0.2" },
    "run_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "dataset_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "case_id": { "type": "string", "minLength": 1 },
    "configuration_id": { "type": "string", "minLength": 1 },
    "target_revision": { "type": "string", "minLength": 1 },
    "target_type": { "enum": ["agent", "skill", "agent_with_skill"] },
    "model": {
      "type": "object",
      "required": ["provider", "model_id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "tool_versions": { "type": "object", "additionalProperties": { "type": "string" } },
    "status": { "enum": ["valid", "agent_failed", "environment_failed", "grader_failed", "unknown", "cancelled"] },
    "seed": { "type": ["string", "integer", "null"] },
    "pair_id": { "type": ["string", "null"] },
    "repeat_group_id": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "trace_ref": { "type": ["string", "null"] },
    "result_ref": { "type": ["string", "null"] },
    "outcomes": {
      "type": "object",
      "required": ["agent_outcome", "process_outcome", "grader_outcome", "gold_outcome"],
      "properties": {
        "agent_outcome": { "enum": ["pass", "fail", "abstain", "unknown"] },
        "process_outcome": { "enum": ["pass", "fail", "unknown"] },
        "grader_outcome": { "enum": ["pass", "fail", "abstain", "unknown"] },
        "gold_outcome": { "enum": ["pass", "fail", "unknown"] },
        "grader_id": { "type": ["string", "null"] },
        "grader_revision": { "type": ["string", "null"] },
        "gold_source": { "enum": ["independent_oracle", "expert_adjudication", "historical_incident", "not_available"] }
      },
      "additionalProperties": false
    },
    "fault": {
      "type": "object",
      "required": ["kind", "injected", "detected", "failure_exposed"],
      "properties": {
        "kind": { "enum": ["none", "historical", "mutation"] },
        "fault_id": { "type": ["string", "null"] },
        "injected": { "type": "boolean" },
        "detected": { "type": ["boolean", "null"] },
        "failure_exposed": { "type": ["boolean", "null"] }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": ["duration_seconds", "input_tokens", "output_tokens", "tool_calls", "cost_usd"],
      "properties": {
        "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "valid" } }, "required": ["status"] },
      "then": { "properties": { "trace_ref": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "fault": { "properties": { "kind": { "const": "none" } }, "required": ["kind"] } }, "required": ["fault"] },
      "then": { "properties": { "fault": { "properties": { "injected": { "const": false } } } } }
    }
  ],
  "additionalProperties": false
}