{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Ground Truth",
  "type": "object",
  "required": [
    "ground_truth_id",
    "version",
    "sources",
    "facts",
    "rules",
    "capabilities",
    "scenarios",
    "workflows",
    "risks",
    "coverage_requirements",
    "information_gaps",
    "adjudication",
    "provenance"
  ],
  "properties": {
    "ground_truth_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "authority",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "statement",
          "source_refs"
        ],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "statement",
          "source_refs",
          "status"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "CONFLICTED",
              "PROVISIONAL",
              "REJECTED"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "name",
          "source_refs"
        ],
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "name",
          "source_refs"
        ],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workflow_id",
          "name",
          "source_refs"
        ],
        "properties": {
          "workflow_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk_id",
          "statement",
          "source_refs"
        ],
        "properties": {
          "risk_id": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "coverage_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "coverage_item_id",
          "target_refs",
          "description",
          "source_refs"
        ],
        "properties": {
          "coverage_item_id": {
            "type": "string"
          },
          "target_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "criticality": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "dataset_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "该覆盖要求适用的数据集 ID；省略时适用于本任务全部数据集。"
          }
        }
      }
    },
    "information_gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "adjudication": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPROVED",
            "PENDING",
            "CONFLICTED",
            "REJECTED"
          ]
        },
        "decision_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "minProperties": 1
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "adjudication": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "adjudication"
        ]
      },
      "then": {
        "properties": {
          "adjudication": {
            "required": [
              "decision_ref",
              "reviewer"
            ],
            "properties": {
              "decision_ref": {
                "type": "string",
                "minLength": 1
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "provenance": {
            "required": [
              "created_by"
            ],
            "properties": {
              "created_by": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
