{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaluation-dataset-builder.local/schemas/v0.0.3/failure-qualification.schema.json",
  "title": "Failure Qualification Record",
  "description": "Evidence-backed qualification of a candidate failure. A concrete attribution requires supporting evidence; unknown is a valid outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "candidate_id",
    "attribution",
    "decision_context",
    "task_contract",
    "evidence_sufficiency",
    "review_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.0.3"
    },
    "qualification_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attribution": {
      "enum": [
        "agent_decision",
        "missing_context",
        "task_ambiguity",
        "tool_failure",
        "environment_failure",
        "stochastic",
        "mixed",
        "unknown"
      ]
    },
    "decision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_event_ref",
        "available_information_refs",
        "could_reasonably_avoid_error",
        "post_hoc_requirement_added"
      ],
      "properties": {
        "critical_event_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "available_information_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "could_reasonably_avoid_error": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "uncertain"
          ]
        },
        "post_hoc_requirement_added": {
          "type": "boolean"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        }
      }
    },
    "task_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_identifiable",
        "deliverable_identifiable",
        "quality_criteria_identifiable"
      ],
      "properties": {
        "input_identifiable": {
          "type": "boolean"
        },
        "deliverable_identifiable": {
          "type": "boolean"
        },
        "quality_criteria_identifiable": {
          "type": "boolean"
        },
        "criteria_description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 3000
        }
      }
    },
    "environment_health": {
      "enum": [
        "healthy",
        "degraded",
        "failed",
        "not_observed",
        "unknown"
      ]
    },
    "evidence_sufficiency": {
      "enum": [
        "sufficient_for_candidate",
        "insufficient",
        "contradictory",
        "unknown"
      ]
    },
    "review_status": {
      "enum": [
        "pending",
        "qualified",
        "rejected",
        "needs_independent_review"
      ]
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    }
  }
}
