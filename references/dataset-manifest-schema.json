{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "评测数据集清单",
  "type": "object",
  "required": ["dataset_id", "version", "evaluation_target", "purpose", "scope", "coverage", "case_count", "quality_status", "execution_status"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1, "description": "数据集稳定标识。"},
    "version": {"type": "string", "minLength": 1, "description": "数据集版本。"},
    "evaluation_target": {"type": "string", "minLength": 1, "description": "被评测对象及版本/范围。"},
    "purpose": {"type": "string", "minLength": 1, "description": "数据集用途、目标用户和预期决策。"},
    "scope": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "business_model_refs": {"type": "array", "items": {"type": "string"}, "description": "业务模型标识引用。"},
    "source_refs": {"type": "array", "items": {"type": "string"}, "description": "来源清单引用。"},
    "case_count": {"type": "integer", "minimum": 0, "description": "用例总数。"},
    "coverage": {
      "type": "object",
      "required": ["universe_definition", "dimensions"],
      "properties": {
        "universe_definition": {"type": "string", "minLength": 1, "description": "覆盖范围全集及其定义。"},
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "total", "covered", "coverage_rate", "uncovered"],
            "properties": {
              "dimension": {"type": "string", "minLength": 1},
              "total": {"type": "integer", "minimum": 0},
              "covered": {"type": "integer", "minimum": 0},
              "coverage_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "uncovered": {"type": "array", "items": {"type": "string"}},
              "notes": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "high_risk_coverage": {"type": "object", "description": "关键风险覆盖情况及证据。"},
        "gap_priorities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gap_id", "priority", "reason"],
            "properties": {
              "gap_id": {"type": "string"},
              "priority": {"enum": ["critical", "high", "medium", "low"]},
              "reason": {"type": "string"},
              "planned_action": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "grader_refs": {"type": "array", "items": {"type": "string"}},
    "quality_status": {"enum": ["candidate", "validated", "approved", "needs_info", "rejected"]},
    "execution_status": {"enum": ["DESIGN_ONLY", "READY_TO_RUN", "EXECUTION_VERIFIED", "NOT_RUN"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "change_log": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
